# Supabase (server only)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Production frontend origin(s), comma-separated. Do not use * in production.
CORS_ORIGINS="https://<frontend>.onrender.com"

# Emergent Universal LLM key (Claude for explanations + multilingual translations)
EMERGENT_LLM_KEY="sk-emergent-XXXXXXXX"

# SMS provider (current implementation is Twilio; provider abstraction will be migrated separately)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# V5 model path override (optional)
# MODEL_PATH="/app/backend/ml/v5_final_model.joblib"
